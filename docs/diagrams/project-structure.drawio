        <mxCell id="design-notes" value="Single objective, single GP output.&#10;Search returns points or whole q-batches.&#10;&#10;Registry selection uses _target_.&#10;MACE / qMACE / LogEI / EI&#10;are direct registry keys.&#10;&#10;For qMACE, return_all=False&#10;selects one complete q-batch." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=22;fontColor=#334155;">
          <mxGeometry x="60" y="1550" width="480" height="420" as="geometry" />
        </mxCell>
